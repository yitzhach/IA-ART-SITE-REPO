{
  "name": "studio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write src worker tests scripts index.html",
    "format:check": "prettier --check src worker tests scripts index.html",
    "test:screens": "node tests/screens.mjs",
    "test:site": "node tests/site/checks.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0"
  }
}
