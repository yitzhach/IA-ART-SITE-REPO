{
  // Nothing deploys from this repo by itself. Staging is deployed by Art-Talk-Back's "Deploy staging" workflow;
  // production's first deploy is Isaac's (stage 2).
  "name": "studio-site",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker answers everything but the built files: the public pages, /studio (for its security headers),
    // /v1 and /assistant.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/site/*"]
  },
  // The studio platform (yitzhach/Art-Talk-Back): its API as /v1/*, its assistant as /assistant/*, on this origin.
  // The studio the public site shows (D-117). Production's is set before its first deploy.
  "vars": {"STUDIO_SLUG": ""},
  // This deploy's id: part of the public pages' cache key, so new templates show at once.
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "services": [
    {"binding": "API", "service": "studio-api"},
    {"binding": "ASSISTANT", "service": "studio-assistant"}
  ],
  "env": {
    "staging": {
      "name": "studio-site-staging",
      "vars": {"STUDIO_SLUG": "isaac-anderson-art-sbtwkm"},
      "version_metadata": {"binding": "CF_VERSION_METADATA"},
      "services": [
        {"binding": "API", "service": "studio-api-staging"},
        {"binding": "ASSISTANT", "service": "studio-assistant-staging"}
      ]
    }
  }
}
