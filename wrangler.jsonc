{
  // Nothing deploys from this repo by itself. Staging is deployed by Art-Talk-Back's "Deploy staging" workflow;
  // production's first deploy is Isaac's (stage 2).
  "name": "studio-site",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/assistant/*", "/", "/studio", "/studio/*"]
  },
  // The studio platform (yitzhach/Art-Talk-Back): its API as /v1/*, its assistant as /assistant/*, on this origin.
  "services": [
    {"binding": "API", "service": "studio-api"},
    {"binding": "ASSISTANT", "service": "studio-assistant"}
  ],
  "env": {
    "staging": {
      "name": "studio-site-staging",
      "services": [
        {"binding": "API", "service": "studio-api-staging"},
        {"binding": "ASSISTANT", "service": "studio-assistant-staging"}
      ]
    }
  }
}
